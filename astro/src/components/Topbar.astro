---
const { lang = 'ca' } = Astro.props;
const base = import.meta.env.BASE_URL;
const t = {
  ca: { nav1: 'Habitatge', nav2: 'Autònoms', nav3: 'Estudis' },
  es: { nav1: 'Vivienda', nav2: 'Autónomos', nav3: 'Estudios' },
}[lang];
const otherLang = lang === 'ca' ? 'es' : 'ca';
const altPath = Astro.url.pathname.replace(`/${lang}/`, `/${otherLang}/`);
---
<header class="topbar">
  <div class="topbar-inner">
    <a href={`${base}${lang}/`} class="brand" style="text-decoration:none">
      <span class="brand-mark">A</span>
      <span>AjutsCat</span>
      <span style="font-family:var(--mono);font-size:11px;color:var(--ink-muted);font-weight:400;margin-left:4px">v0.1</span>
    </a>
    <nav class="topbar-nav keep">
      <a href={`${base}${lang}/?cat=vivienda`}>{t.nav1}</a>
      <a href={`${base}${lang}/?cat=autonomos`}>{t.nav2}</a>
      <a href={`${base}${lang}/?cat=estudios`}>{t.nav3}</a>
      <div class="lang" role="group" aria-label="Language">
        <a href={`${base}ca/`} class={lang === 'ca' ? 'active' : ''}
           style="text-decoration:none;display:inline-block;padding:3px 10px;border-radius:999px"
           >CA</a>
        <a href={`${base}es/`} class={lang === 'es' ? 'active' : ''}
           style="text-decoration:none;display:inline-block;padding:3px 10px;border-radius:999px"
           >ES</a>
      </div>
    </nav>
  </div>
</header>
<style>
  .lang a { color: var(--ink-muted); font-family: var(--mono); font-size: 11px; letter-spacing: 0.02em; text-transform: uppercase; font-weight: 600; }
  .lang a.active { background: var(--ink); color: var(--bg); }
</style>
